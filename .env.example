# 이 파일을 복사해 .env를 만들고 change_me 값들을 바꿔 쓴다. (.env는 커밋하지 않는다)
POSTGRES_USER=wewant
POSTGRES_PASSWORD=change_me
POSTGRES_DB=wewant
POSTGRES_PORT=5432

DATABASE_URL="postgresql://wewant:change_me@localhost:5432/wewant?schema=public"

# 로그인(Better Auth). SECRET은 32자 이상 무작위 문자열
BETTER_AUTH_SECRET=change_me_to_a_random_string_of_32_chars_or_more
BETTER_AUTH_URL=http://localhost:3000

# 시드 계정의 첫 비밀번호 (가상 계정용, 8자 이상). 첫 로그인 때 변경을 강제한다
SEED_DEFAULT_PASSWORD=change_me
